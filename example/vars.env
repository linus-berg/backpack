# Backpack Core Configuration
BP_OTEL_HOST=http://telemetry-otel:4317
BP_API_HOST=http://api:80
BP_LOGS=/logs/

# Messaging (RabbitMQ)
BP_RABBIT_MQ_HOST=rabbitmq
BP_RABBIT_MQ_USER=backpack
BP_RABBIT_MQ_PASS=backpack_pass

# Persistence
BP_REDIS_HOST=redis
BP_MONGO_STR=mongodb://backpack:backpack_pass@mongo:27017

# Object Storage (MinIO / S3)
BP_S3_ENDPOINT=http://minio:9000
BP_S3_BUCKET=backpack
BP_S3_ACCESS_KEY=minio-bp
BP_S3_SECRET_KEY=minio-bp

# Security (OIDC)
OIDC_AUTHORITY=http://localhost:8090/realms/backpack
OIDC_AUDIENCE=backpack

# Network Proxy (Optional)
# HTTP_PROXY=http://your-proxy:8080
# HTTPS_PROXY=http://your-proxy:8080
# NO_PROXY=localhost,127.0.0.1,mongo,rabbitmq,redis,minio

# Ecosystem Specific
ARTIFACTHUB_API_KEY_ID=
ARTIFACTHUB_API_KEY_SECRET=
