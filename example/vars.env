# Environment for every Backpack service in docker-compose.yml.
# Full reference: ../docs/Configuration.md
# The credentials match the defaults in docker-compose.yml; change both together.

# Telemetry is off: this example has no OpenTelemetry Collector.
BP_OTEL_HOST=

# Messaging (RabbitMQ)
BP_RABBIT_MQ_HOST=rabbitmq
BP_RABBIT_MQ_USER=backpack
BP_RABBIT_MQ_PASS=backpack_pass
BP_RABBIT_MQ_API=http://rabbitmq:15672

# Metadata and cache (API, gateway, scheduler)
BP_MONGO_STR=mongodb://backpack:backpack_pass@mongo:27017
BP_REDIS_HOST=redis
BP_REDIS_USER=default
BP_REDIS_PASS=backpack_pass

# Object storage (collectors)
BP_S3_ENDPOINT=s3:9000
BP_S3_REGION=us-east-1
BP_S3_BUCKET=backpack
BP_S3_ACCESS_KEY=backpack
BP_S3_SECRET_KEY=backpack_pass

# Sign-in (API). Must be the same URL for browsers and the API; see README.md.
BP_OIDC_AUTHORITY=http://keycloak:8090/realms/backpack
BP_OIDC_AUDIENCE=backpack

# Outbound proxy (optional). .NET services, git and skopeo honour these.
# HTTP_PROXY=http://your-proxy:8080
# HTTPS_PROXY=http://your-proxy:8080
# NO_PROXY=localhost,127.0.0.1,mongo,rabbitmq,redis,s3,keycloak

# Processor.Helm only (optional)
# ARTIFACTHUB_API_KEY_ID=
# ARTIFACTHUB_API_KEY_SECRET=
