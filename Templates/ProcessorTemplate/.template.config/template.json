{
  "$schema": "http://json.schemastore.org/template",
  "author": "Backpack",
  "classifications": [ "Backpack", "Processor", "Artifact" ],
  "name": "Backpack Artifact Processor",
  "identity": "Backpack.Processor.Template",
  "shortName": "backpack-processor",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "_NAME_",
  "preferNameDirectory": true,
  "symbols": {
    "ENDPOINT": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "myprocessor",
      "replaces": "_ENDPOINT_"
    },
    "BASE_URL": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "https://api.upstream.com",
      "replaces": "_BASE_URL_"
    }
  },
  "sources": [
    {
      "exclude": [ "**/[Bb]in/**", "**/[Oo]bj/**", ".template.config/**" ]
    }
  ]
}
